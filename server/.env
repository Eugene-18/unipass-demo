# ============================================
# SMTP 郵件設定（推薦使用 Gmail - 埠號 465）
# ============================================

# Gmail 帳號 - 填入你的完整 Email 地址
# 例如：chloe@gmail.com
EMAIL_USER=unipass115507@gmail.com

# Google 應用程式專用密碼 - 16 位元密碼
# 申請步驟：
# 1. 進入 Google 帳戶 → 安全性
# 2. 開啟「兩步驟驗證」
# 3. 在安全性頁面找到「應用程式密碼」
# 4. 選擇「郵件」和「Windows 電腦」
# 5. 系統會產生 16 位密碼，去掉空格後貼入下方
# 例如：mwxm njym ybyc twau → 去掉空格 → mwxmnjymbyyctwau
EMAIL_PASS=mkhrjtqwyujshtif

# 前端密碼重置頁面的完整 URL
FRONTEND_URL=http://localhost:5173

# ============================================
# Google OAuth 設定
# ============================================

# Google Client ID - 用於 Google 登入驗證
GOOGLE_CLIENT_ID=41038233355-drmfvjdm3b52kucka75u2nku0k2uq086.apps.googleusercontent.com

# Google Client Secret - 用於 Google 登入驗證
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# 忘記密碼流程限制 (可選)
# ============================================

# 單一 Email 冷卻秒數，避免短時間重複寄送
RESET_EMAIL_COOLDOWN_SECONDS=60

# 允許重設密碼的網域白名單 (逗號分隔)
# 留空 = 不限制網域
# 範例: gmail.com,ntub.edu.tw
RESET_EMAIL_ALLOWED_DOMAINS=

