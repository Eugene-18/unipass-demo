# 郵件設定（忘記密碼功能需要）
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password

# 前端與後端網址
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Google OAuth（不使用 Google 登入時可留空）
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 資料庫
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# 藍新金流 MPG 2.0
NEWEBPAY_MERCHANT_ID=your_merchant_id
NEWEBPAY_HASH_KEY=your_32_byte_hash_key
NEWEBPAY_HASH_IV=your_16_byte_hash_iv
NEWEBPAY_VERSION=2.0
NEWEBPAY_PAY_GATEWAY=https://ccore.newebpay.com/MPG/mpg_gateway

# 藍新背景通知網址：正式使用必須是外網可連線的 HTTPS URL。
# 本機開發可使用 ngrok 等反向代理；這個網址不影響瀏覽器付款完成後的 ReturnURL 導回。
NEWEBPAY_NOTIFY_URL=https://your-public-domain.example.com/api/payment/notify

# 瀏覽器付款完成後，藍新會 POST 回這個網址，再由後端 303 導回前端結果頁。
# 本機測試可使用 localhost；正式環境請改成公開 HTTPS 網址。
NEWEBPAY_RETURN_URL=http://localhost:3000/api/payment/return

# 忘記密碼限制（可選）
RESET_EMAIL_COOLDOWN_SECONDS=60
RESET_EMAIL_ALLOWED_DOMAINS=
